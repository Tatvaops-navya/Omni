{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/tatva-api/:path*",
      "destination": "https://api.withtatva.ai/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://tatvaops-omni-dev.onrender.com/admin/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://tatvaops-omni-dev.onrender.com/media/:path*"
    },
    { "source": "/krsna/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/krsna", "destination": "/krsna/" },
    { "source": "/krsna/(.*)", "destination": "/index.html" },
    { "source": "/", "destination": "/krsna/" }
  ]
}
